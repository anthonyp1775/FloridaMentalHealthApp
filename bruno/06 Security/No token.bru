meta {
  name: No token
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/counties
  auth: none
}

tests {
  // 401 means "you are not logged in", 403 means "you are, but you
  // may not". Spring's default for a stateless config returns 403 for
  // both; JwtAuthEntryPoint exists to make this distinction correct.
  test("401 Unauthorized, not 403", function() {
    expect(res.getStatus()).to.equal(401);
  });
}
