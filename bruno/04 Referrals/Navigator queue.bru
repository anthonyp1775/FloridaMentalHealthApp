meta {
  name: Navigator queue
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/referrals/queue
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

tests {
  test("200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("everything in it is PENDING", function() {
    res.body.content.forEach(r => {
      expect(r.status).to.equal("PENDING");
    });
  });

  // Oldest first, deliberately: a newest-first queue guarantees the
  // longest-waiting request is the one nobody sees.
  test("ordered oldest first", function() {
    const dates = res.body.content.map(r => new Date(r.submittedAt).getTime());
    const sorted = [...dates].sort((a, b) => a - b);
    expect(dates).to.deep.equal(sorted);
  });
}
