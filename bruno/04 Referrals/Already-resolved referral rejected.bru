meta {
  name: Already-resolved referral rejected
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/referrals/{{referralId}}/decision
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:json {
  {
    "status": "DECLINED",
    "note": "This one is already closed"
  }
}

tests {
  test("400 Bad Request", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("says it is already resolved", function() {
    expect(res.body.message).to.contain("already");
  });
}
