meta {
  name: Register with invalid payload
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstName": "",
    "lastName": "Tester",
    "email": "not-an-email",
    "password": "short"
  }
}

tests {
  test("400 Bad Request", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("names every offending field", function() {
    expect(res.body.fieldErrors).to.have.property("firstName");
    expect(res.body.fieldErrors).to.have.property("email");
    expect(res.body.fieldErrors).to.have.property("password");
  });
}
