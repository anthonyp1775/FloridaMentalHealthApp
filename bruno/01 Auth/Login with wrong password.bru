meta {
  name: Login with wrong password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{clientEmail}}",
    "password": "definitely-not-the-password"
  }
}

tests {
  test("401 Unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
  });

  // The message must be identical for a bad password and an unknown
  // email. Distinguishing them lets an attacker enumerate accounts.
  test("message does not reveal whether the account exists", function() {
    expect(res.body.message).to.equal("Email or password is incorrect");
  });
}
